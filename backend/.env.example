# Copy this file to .env and fill in your own key. .env is where the
# ONE secret this codebase itself needs lives — everything else
# (Postman API key, target API credentials) is provided per-session by
# whoever uses the app, and lives only in session_store.py's in-memory
# store, never in a file like this one.

ANTHROPIC_API_KEY=sk-ant-...

# --- Target host policy ------------------------------------------------
# Phase 1 (testing, current): any host in the collection/environment is
# callable. Leave both of these unset.
#
# Phase 2 (later): restrict to sandbox/staging hosts with no code change.
#   DEMOFORGE_HOST_POLICY=allowlist
#   DEMOFORGE_HOST_ALLOWLIST=sandbox.*,staging.*,*.test.internal
# Patterns match the HOSTNAME only. Any policy value other than "open"
# means allowlist mode, so a typo fails closed rather than wide open.
